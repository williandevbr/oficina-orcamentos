# ============================================================
# OrcaPro - Exemplo de configuração (para o Git)
# Copie este arquivo para ".env" e preencha com suas chaves.
# NUNCA coloque chaves reais neste arquivo de exemplo.
# ============================================================

# Endereco do projeto no Supabase (Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica (anon) - painel: Settings -> API -> anon public
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# Chave de servico (secreta) - painel: Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_AQUI

# Dados da oficina (aparecem no PDF do orcamento)
OFICINA_NOME=Sua Oficina
OFICINA_TELEFONE=(00) 00000-0000
OFICINA_ENDERECO=Endereco da oficina
OFICINA_CNPJ=00.000.000/0000-00

# Site liberado no CORS (separar por vírgula se tiver mais de um)
FRONTEND_URL=http://localhost:5173

# Porta do servidor
PORT=3333